  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HospitalInteractable
  infoTitle: HealthBridge (SehatSetu) Digital Information Hub
  category: Hospital & Community Overview
  infoDescription: "HealthBridge (SehatSetu) Mission:\nBridging the healthcare divide by providing high-quality, dignified medical care to rural and underserved communities.\n\nBuilding Directory:\n\u2022 Ground Floor: Reception, Jan-Aushadhi Pharmacy, OPD Clinic 1, 24x7 Emergency (ER)\n\u2022 1st Floor: Diagnostics Lab, Digital X-Ray / Ultrasound, Tele-Health Command Unit\n\u2022 2nd Floor: Inpatient Wards, High Dependency Unit (HDU), Operation Theatre\n\nToll-Free Patient Helpline: 1800-SEHAT-SETU | Emergency Helpline: 108"
  interactionPrompt: Press [E] for Hospital Directory & Services
  themeColor: {r: 0.12, g: 0.65, b: 0.85, a: 1}
