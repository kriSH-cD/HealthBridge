# Production env for the root Dockerfile (Dokploy: Application > Environment).
# Local dev uses server/.env.example instead.

# Dokploy Postgres > "Internal Connection URL"
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/sehatsetu

# Required; generate with: openssl rand -hex 32
SECRET_KEY=

PORT=8000
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Optional: auth rate limiting. Without it, login still works (no rate limit).
# REDIS_URL=redis://default:PASSWORD@HOST:6379

# Keep off in production; load demo data with `npm run seed` instead.
ENABLE_DEMO_SEED=false
