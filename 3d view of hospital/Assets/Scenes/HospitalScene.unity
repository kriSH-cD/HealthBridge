  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HospitalInteractable
  infoTitle: HealthBridge Reception & Registration
  category: Patient Admissions
  infoDescription: "Welcome to HealthBridge Hospital (SehatSetu).\n\n\u2022 OPD Registration: 8:00 AM \u2013 8:00 PM Daily\n\u2022 Digital Ayushman Card & ABHA Health ID verification\n\u2022 Telemedicine scheduling with super-specialty urban hubs\n\u2022 Wheelchair assistance, priority queues & patient advocacy\n\nNeed help navigating? Check our Information Kiosk or ask our duty desk coordinator."
  interactionPrompt: Press [E] to Speak with Receptionist
  themeColor: {r: 0.08, g: 0.44, b: 0.76, a: 1}
  highlightRenderer: {fileID: 0}
