  m_EditorClassIdentifier: Assembly-CSharp::HospitalInteractable
  infoTitle: "Doctor Consultation Room \u2013 OPD 1"
  category: Clinical Services
  infoDescription: "Consulting Medical Specialists:\n\n\u2022 Dr. Ananya Sharma (MD - Internal Medicine)\n  OPD Timings: Monday \u2013 Saturday (9:00 AM \u2013 2:00 PM)\n\n\u2022 Dr. Rajesh Patel (MS - Tele-Medicine Specialist)\n  Rural Virtual Consultations: Monday \u2013 Friday (3:00 PM \u2013 7:00 PM)\n\n\u2022 Dr. Priya Verma (MBBS, DGO - Maternal Care Specialist)\n  Prenatal & Postnatal OPD: Tuesday & Thursday (10:00 AM \u2013 1:00 PM)\n\nServices: General consultation, preventive checkups, digital prescription issuance, referral to regional super-specialty hospitals."
  interactionPrompt: Press [E] to Check Doctor Schedule & OPD
  themeColor: {r: 0.18, g: 0.58, b: 0.35, a: 1}
  highlightRenderer: {fileID: 0}
